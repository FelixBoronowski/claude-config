{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${USERPROFILE:-$HOME}/.claude/hooks/cbm-hook.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${USERPROFILE:-$HOME}/.claude/hooks/cbm-hook.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${USERPROFILE:-$HOME}/.claude/hooks/cbm-hook.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${USERPROFILE:-$HOME}/.claude/hooks/cbm-hook.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${USERPROFILE:-$HOME}/.claude/hooks/cbm-hook.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${USERPROFILE:-$HOME}/.claude/hooks/cbm-hook.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${USERPROFILE:-$HOME}/.claude/hooks/cbm-hook.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${USERPROFILE:-$HOME}/.claude/hooks/worktree-create.js\"",
            "timeout": 600
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${USERPROFILE:-$HOME}/.claude/hooks/worktree-remove.js\"",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"${USERPROFILE:-$HOME}/.claude/hooks/statusline.js\""
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "node \"${USERPROFILE:-$HOME}/.claude/hooks/statusline.js\" subagent"
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "feedbackDrafts": "notify",
  "awaySummaryEnabled": false,
  "prefersReducedMotion": true,
  "timeFormat": "auto",
  "autoCompactEnabled": false,
  "idleCompaction": false,
  "switchModelsOnFlag": true,
  "autoContinueAtUsageLimit": false,
  "fileCheckpointingEnabled": false,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "useAutoModeDuringPlan": true,
  "workflowKeywordTriggerEnabled": false,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  }
}
