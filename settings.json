{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet restore:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(uv run pytest:*)",
      "Bash(mypy:*)",
      "Bash(ruff check:*)",
      "Bash(bundle exec rspec:*)",
      "Bash(bundle exec rubocop:*)",
      "Bash(rake test:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(dotnet csharpier:*)",
      "Bash(dotnet format:*)",
      "Bash(uv sync:*)",
      "Bash(uv run ruff:*)",
      "Bash(ruff format:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run pyright:*)"
    ],
    "defaultMode": "auto"
  },
  "fallbackModel": [
    "claude-sonnet-5-5"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${USERPROFILE:-$HOME}/.claude/hooks/cbm-hook.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${USERPROFILE:-$HOME}/.claude/hooks/cbm-hook.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${USERPROFILE:-$HOME}/.claude/hooks/cbm-hook.js\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"${USERPROFILE:-$HOME}/.claude/hooks/config-sync-check.js\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${USERPROFILE:-$HOME}/.claude/hooks/cbm-hook.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${USERPROFILE:-$HOME}/.claude/hooks/cbm-hook.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${USERPROFILE:-$HOME}/.claude/hooks/cbm-hook.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${USERPROFILE:-$HOME}/.claude/hooks/cbm-hook.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"${USERPROFILE:-$HOME}/.claude/hooks/statusline.js\""
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "node \"${USERPROFILE:-$HOME}/.claude/hooks/statusline.js\" subagent"
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {},
  "effortLevel": "medium",
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "autoCompactWindow": 500000,
  "askUserQuestionTimeout": "10m",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "crossSessionInbound": "accept",
  "inputNeededNotifEnabled": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
